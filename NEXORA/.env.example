# ---- API ----
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora
REDIS_URL=redis://localhost:6379
# Comma-separated list of browser origins allowed to call the API directly.
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# auto | true | false — whether session cookies require HTTPS
COOKIE_SECURE=auto

# ---- Web ----
# Server-side fetches from Next.js to the API:
API_ORIGIN=http://127.0.0.1:4000
# Dev proxy target (browser -> same-origin /api/v1 -> API):
API_PROXY_TARGET=http://127.0.0.1:4000

# ---- Seed ----
SEED_PASSWORD=Password123!
