# ──────────────────────────────────────────────────────────────
# Nexora CRM — environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ──────────────────────────────────────────────────────────────

# Runtime: development | production
NODE_ENV=development

# PostgreSQL (docker compose: infrastructure/docker-compose.yml)
DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora

# Redis (used for rate limiting / caching — optional in early phases)
REDIS_URL=redis://localhost:6379

# API server
API_PORT=4000
# Comma-separated list of allowed browser origins (CORS, credentials)
WEB_ORIGINS=http://localhost:3000
# Set cookie `Secure` flag. Leave empty to auto-detect (secure unless localhost).
COOKIE_SECURE=

# Web app (Next.js) — must be prefixed with NEXT_PUBLIC_ to reach the browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# Seed script demo password (db:seed)
DEMO_PASSWORD=Demo1234!
