# -----------------------------------------------------------------------------
# BUSINEX environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# -----------------------------------------------------------------------------

# Runtime: development | test | production
NODE_ENV=development

# PostgreSQL (infrastructure/docker-compose.yml)
DATABASE_URL=postgresql://businex:businex@localhost:5432/businex

# Redis (rate limiting / caching - optional in early phases)
REDIS_URL=redis://localhost:6379

# API server
API_PORT=4000
# Comma-separated list of allowed browser origins (CORS, credentials)
WEB_ORIGINS=http://localhost:3000
# Set cookie `Secure` flag. Leave empty to auto-detect (unless localhost).
COOKIE_SECURE=

# JWT Signing secret (replace in production)
JWT_SECRET=dev-only-change-me

# Seed script demo password (db:seed)
DEMO_PASSWORD=Demo1234!

# Web app (Next.js) - must be prefixed with NEXT_PUBLIC_ to reach the browser
NEXT_PUBLIC_API_URL=http://localhost:4000
