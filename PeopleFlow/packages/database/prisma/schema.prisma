// PeopleFlow — multi-tenant HR platform schema
// Every tenant-owned model carries organizationId and cascades from Organization.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core identity & tenancy ──────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               Membership[]
  roles               Role[]
  employees           Employee[]
  departments         Department[]
  teams               Team[]
  locations           Location[]
  jobTitles           JobTitle[]
  statuses            EmployeeStatusDef[]
  customFields        CustomFieldDef[]
  salaryRecords       SalaryRecord[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  holidays            PublicHoliday[]
  workSchedules       WorkSchedule[]
  attendanceEntries   AttendanceEntry[]
  documents           Document[]
  goals               Goal[]
  reviewCycles        ReviewCycle[]
  reviews             Review[]
  feedbackItems       Feedback[]
  jobOpenings         JobOpening[]
  candidates          Candidate[]
  applications        Application[]
  interviews          Interview[]
  courses             Course[]
  trainingAssignments TrainingAssignment[]
  certifications      Certification[]
  announcements       Announcement[]
  tasks               Task[]
  workflowTemplates   WorkflowTemplate[]
  workflowRuns        WorkflowRun[]
  importJobs          ImportJob[]
  leaveBalances       LeaveBalance[]
  documentVersions    DocumentVersion[]
  interviewFeedbacks  InterviewFeedback[]
  announcementReactions AnnouncementReaction[]
  announcementComments  AnnouncementComment[]

  @@index([slug])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  isPlatformAdmin Boolean  @default(false)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships            Membership[]
  sessions               Session[]
  employee               Employee?
  approvedLeaveRequests  LeaveRequest[]        @relation("LeaveApprover")
  uploadedDocuments      Document[]
  conductedReviews       Review[]              @relation("ReviewManager")
  interviewFeedbacks     InterviewFeedback[]
  announcements          Announcement[]
  announcementReactions  AnnouncementReaction[]
  announcementComments   AnnouncementComment[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]

  @@index([email])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  isOwner        Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // Wildcard "*" grants everything; otherwise explicit permission keys like "employee.view"
  permissions    String[]
  systemKey      String?  // "owner" | "administrator" | "hr_manager" | "manager" | "employee" for seeded roles
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String? // denormalized on purpose: audit entries survive actor deletion
  actorName      String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
}

// ─── People ───────────────────────────────────────────────────────────────────

model Employee {
  id                    String    @id @default(cuid())
  organizationId        String
  userId                String?   @unique
  employeeNumber        String
  firstName             String
  lastName              String
  photoUrl              String?
  email                 String
  phone                 String?
  dateOfBirth           DateTime?
  address               String?
  jobTitleId            String?
  departmentId          String?
  teamId                String?
  managerId             String?
  locationId            String?
  employmentType        EmploymentType
  startDate             DateTime
  statusId              String
  terminationDate       DateTime?
  skills                String[]
  emergencyContactName  String?
  emergencyContactPhone String?
  customFields          Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  department      Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team            Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  location        Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  jobTitle        JobTitle?          @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  status          EmployeeStatusDef  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  manager         Employee?          @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports   Employee[]         @relation("EmployeeManager")

  managedDepartments Department[]     @relation("DepartmentManager")
  ledTeams           Team[]           @relation("TeamLead")
  salaryRecords      SalaryRecord[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  attendanceEntries  AttendanceEntry[]
  documents          Document[]
  goals              Goal[]
  reviews            Review[]
  feedbackAbout      Feedback[]       @relation("FeedbackAbout")
  feedbackGiven      Feedback[]       @relation("FeedbackFrom")
  trainingAssignments TrainingAssignment[]
  certifications     Certification[]
  tasks              Task[]
  workflowRuns       WorkflowRun[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, email])
  @@index([organizationId, statusId])
  @@index([organizationId, departmentId])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, startDate])
  @@index([managerId])
}

model EmployeeStatusDef {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  category       EmployeeStatusCategory
  color          String                @default("#64748b")
  isDefault      Boolean               @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
}

model Department {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  parentId          String?
  managerEmployeeId String?
  createdAt         DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Department[] @relation("DepartmentTree")
  managerEmployee Employee?    @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employees       Employee[]
  teams           Team[]
  jobOpenings     JobOpening[]

  @@unique([organizationId, name])
  @@index([organizationId, parentId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  departmentId   String?
  leadEmployeeId String?
  createdAt      DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadEmployee  Employee?    @relation("TeamLead", fields: [leadEmployeeId], references: [id], onDelete: SetNull)
  employees     Employee[]

  @@unique([organizationId, name])
  @@index([organizationId, departmentId])
}

model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  timezone       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  jobOpenings  JobOpening[]

  @@unique([organizationId, name])
}

model JobTitle {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
}

model CustomFieldDef {
  id             String            @id @default(cuid())
  organizationId String
  entity         CustomFieldEntity
  key            String
  label          String
  type           CustomFieldType
  options        String[]
  required       Boolean           @default(false)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entity, key])
}

// ─── Compensation (payroll foundation — restricted access) ────────────────────

model SalaryRecord {
  id             String          @id @default(cuid())
  organizationId String
  employeeId     String
  type           SalaryRecordType
  currency       String
  amountMinor    Int
  effectiveFrom  DateTime
  note           String?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@index([effectiveFrom])
}

// ─── Leave ────────────────────────────────────────────────────────────────────

model LeaveType {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  annualAllowanceDays Float
  carryOverMaxDays    Float    @default(0)
  paid                Boolean  @default(true)
  requiresApproval    Boolean  @default(true)
  color               String   @default("#6366f1")
  archivedAt          DateTime?
  createdAt           DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organizationId, name])
}

model LeaveBalance {
  id             String  @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  year           Int
  entitled       Float   @default(0)
  carriedOver    Float   @default(0)
  used           Float   @default(0)
  pending        Float   @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([year])
}

model LeaveRequest {
  id             String             @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  days           Float
  status         LeaveRequestStatus @default(PENDING)
  reason         String?
  decisionNote   String?
  approverUserId String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approverUser User?        @relation("LeaveApprover", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId, startDate, endDate])
  @@index([startDate, endDate])
}

model PublicHoliday {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  date           DateTime
  locationId     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@unique([organizationId, date, name])
}

model WorkSchedule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  days           Json // [{day:0..6, enabled, startTime:"09:00", endTime:"17:00"}]
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model AttendanceEntry {
  id              String   @id @default(cuid())
  organizationId  String
  employeeId      String
  date            DateTime @db.Date
  clockIn         DateTime?
  clockOut        DateTime?
  breakMinutes    Int      @default(0)
  workedMinutes   Int      @default(0)
  overtimeMinutes Int      @default(0)
  source          String   @default("clock") // clock | manual
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id             String             @id @default(cuid())
  organizationId String
  title          String
  category       String             @default("other")
  visibility     DocumentVisibility @default(PRIVATE)
  employeeId     String?
  uploaderUserId String?
  currentVersion Int                @default(1)
  fileName       String
  fileKey        String
  fileSize       Int
  mimeType       String
  expiresAt      DateTime?
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploaderUser User?              @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)
  versions     DocumentVersion[]

  @@index([organizationId, employeeId])
  @@index([organizationId, expiresAt])
  @@index([organizationId, category])
}

model DocumentVersion {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  version        Int
  fileKey        String
  fileName       String
  fileSize       Int
  mimeType       String
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

// ─── Performance ──────────────────────────────────────────────────────────────

model Goal {
  id             String     @id @default(cuid())
  organizationId String
  employeeId     String
  title          String
  description    String?
  progress       Int        @default(0)
  dueDate        DateTime?
  status         GoalStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId, status])
}

model ReviewCycle {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  periodStart    DateTime
  periodEnd      DateTime
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews      Review[]

  @@unique([organizationId, name])
}

model Review {
  id             String       @id @default(cuid())
  organizationId String
  cycleId        String
  employeeId     String
  managerUserId  String?
  selfRating     Int?
  selfComments   String?
  managerRating  Int?
  managerComments String?
  summary        String?
  status         ReviewStatus @default(NOT_STARTED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        ReviewCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  managerUser  User?         @relation("ReviewManager", fields: [managerUserId], references: [id], onDelete: SetNull)

  @@unique([cycleId, employeeId])
  @@index([organizationId, status])
}

model Feedback {
  id             String   @id @default(cuid())
  organizationId String
  aboutEmployeeId String
  fromEmployeeId String
  message        String
  anonymous      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aboutEmployee Employee    @relation("FeedbackAbout", fields: [aboutEmployeeId], references: [id], onDelete: Cascade)
  fromEmployee  Employee    @relation("FeedbackFrom", fields: [fromEmployeeId], references: [id], onDelete: Cascade)

  @@index([aboutEmployeeId])
}

// ─── Recruitment ──────────────────────────────────────────────────────────────

model JobOpening {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  description    String?
  employmentType EmploymentType   @default(FULL_TIME)
  departmentId   String?
  locationId     String?
  status         JobOpeningStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([organizationId, status])
}

model Candidate {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String
  phone          String?
  source         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([organizationId, email])
  @@index([organizationId, lastName])
}

model Application {
  id             String           @id @default(cuid())
  organizationId String
  jobId          String
  candidateId    String
  stage          ApplicationStage @default(APPLIED)
  note           String?
  rating         Int?
  appliedAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          JobOpening            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate    Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stageHistory ApplicationStageHistory[]
  interviews   Interview[]

  @@unique([jobId, candidateId])
  @@index([organizationId, stage])
}

model ApplicationStageHistory {
  id            String   @id @default(cuid())
  applicationId String
  stage         ApplicationStage
  changedAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Interview {
  id             String   @id @default(cuid())
  organizationId String
  applicationId  String
  scheduledAt    DateTime
  durationMinutes Int     @default(60)
  meetingLink    String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application  Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  feedbackList InterviewFeedback[]

  @@index([applicationId])
  @@index([scheduledAt])
}

model InterviewFeedback {
  id                String   @id @default(cuid())
  organizationId    String
  interviewId       String
  interviewerUserId String
  recommendation    InterviewRecommendation
  rating            Int?
  notes             String
  createdAt         DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interview       Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerUser User          @relation(fields: [interviewerUserId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerUserId])
}

// ─── Training ────────────────────────────────────────────────────────────────

model Course {
  id                       String    @id @default(cuid())
  organizationId           String
  title                    String
  description              String?
  category                 String?
  contentUrl               String?
  durationHours            Float?
  certificationValidMonths Int?
  archivedAt               DateTime?
  createdAt                DateTime  @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  TrainingAssignment[]

  @@index([organizationId, category])
}

model TrainingAssignment {
  id             String         @id @default(cuid())
  organizationId String
  courseId       String
  employeeId     String
  assignedById   String?
  dueDate        DateTime
  status         TrainingStatus @default(ASSIGNED)
  completedAt    DateTime?
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certification Certification?

  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([dueDate])
}

model Certification {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  name           String
  issuedAt       DateTime
  expiresAt      DateTime?
  assignmentId   String?   @unique

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignment   TrainingAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, expiresAt])
}

// ─── Communication ────────────────────────────────────────────────────────────

model Announcement {
  id             String              @id @default(cuid())
  organizationId String
  authorUserId   String
  title          String
  body           String
  audience       AnnouncementAudience @default(ALL)
  departmentId   String?
  teamId         String?
  allowComments  Boolean             @default(true)
  pinned         Boolean             @default(false)
  publishedAt    DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorUser   User                  @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  reactions    AnnouncementReaction[]
  comments     AnnouncementComment[]

  @@index([organizationId, publishedAt])
}

model AnnouncementReaction {
  id             String   @id @default(cuid())
  organizationId String
  announcementId String
  userId         String
  emoji          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, emoji])
}

model AnnouncementComment {
  id             String   @id @default(cuid())
  organizationId String
  announcementId String
  userId         String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

// ─── Tasks & workflows ────────────────────────────────────────────────────────

model Task {
  id                 String      @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  assigneeEmployeeId String?
  workflowRunId      String?
  workflowStepIndex  Int?
  dueDate            DateTime?
  priority           TaskPriority @default(MEDIUM)
  status             TaskStatus  @default(TODO)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     Employee?    @relation(fields: [assigneeEmployeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([assigneeEmployeeId, status])
  @@index([workflowRunId])
}

model WorkflowTemplate {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  trigger        WorkflowTrigger @default(MANUAL)
  steps          Json // [{title, description?, offsetDays, roleKey}]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         WorkflowRun[]

  @@unique([organizationId, name])
}

model WorkflowRun {
  id             String            @id @default(cuid())
  organizationId String
  templateId     String
  employeeId     String?
  status         WorkflowRunStatus @default(RUNNING)
  startedAt      DateTime          @default(now())
  completedAt    DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employee     Employee?         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id             String    @id @default(cuid())
  userId         String
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
}

// ─── Data import/export ───────────────────────────────────────────────────────

model ImportJob {
  id             String       @id @default(cuid())
  organizationId String
  entity         String
  status         ImportStatus @default(PENDING)
  report         Json?
  createdById    String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

