# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL (required)
DATABASE_URL="postgresql://peopleflow:peopleflow@localhost:5432/peopleflow?schema=public"

# Secret used to sign sessions & tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public URL of the web app (used for links in emails/notifications)
APP_URL="http://localhost:3000"

# ─── API server ──────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS="http://localhost:3000"

# ─── Redis cache / rate-limit backend (optional) ─────────────────────────────
# Leave empty to use the built-in in-memory fallback.
REDIS_URL=""

# ─── File storage (optional) ─────────────────────────────────────────────────
# DRIVER: local | s3   — local stores files under LOCAL_STORAGE_DIR
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./.data/files"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="peopleflow"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Force path-style URLs (true for MinIO)
S3_FORCE_PATH_STYLE="true"

# ─── Email notifications (optional; logs to console when empty) ──────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="PeopleFlow <no-reply@peopleflow.local>"

# ─── AI assistant (optional) ─────────────────────────────────────────────────
# PROVIDER: none | openai | anthropic
AI_PROVIDER="none"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
AI_BASE_URL=""
