# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://supplyflow:supplyflow@localhost:5432/supplyflow

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-generate-a-long-random-string

# ── Redis (optional locally, required for production jobs/cache) ─────
REDIS_URL=redis://localhost:6379

# ── Object storage (S3-compatible; local dev uses ./storage) ─────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=supplyflow
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ── AI assistant (optional; provider-agnostic) ───────────────────────
AI_PROVIDER=none            # none | openai | anthropic | local
AI_API_KEY=
AI_MODEL=
