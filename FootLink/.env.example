# Supabase configuration
# Copy this file to a place where you inject environment variables and never
# commit real values. FootLink reads these at build time via --dart-define.

# Your Supabase project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Your Supabase public (anon) key. NEVER use the service_role key in the app.
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Optional: Firebase Cloud Messaging server key (for push notifications)
FCM_SERVER_KEY=

# Optional: Google sign-in client IDs
GOOGLE_CLIENT_ID=
